{
  "schemaVersion": 1,
  "id": "affogatocore",
  "version": "${version}",
  "name": "Affogato Core",
  "description": "Core mod providing modpack utilities and custom features",
  "authors": ["pajic"],
  "contact": {},
  "license": "MIT",
  "icon": "icon.png",
  "environment": "*",
  "entrypoints": {
    "client": [
      "me.pajic.affogatocore.AffogatoCoreClient"
    ],
    "main": [
      "me.pajic.affogatocore.AffogatoCore"
    ],
    "sodium:config_api_user": [
      "me.pajic.affogatocore.config.ModSodiumConfig"
    ]
  },
  "mixins": [
    "affogatocore.mixins.json"
  ],
  "accessWidener": "affogatocore.classtweaker",
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "~${minecraft_version}"
  }
}
